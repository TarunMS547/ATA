rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document or has a specific role
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    match /projects/{projectId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    match /requirements/{requirementId} {
      allow read, write: if isAuthenticated();
      // In a real app, you would verify the user has access to the associated project
    }

    match /testCases/{testCaseId} {
      allow read, write: if isAuthenticated();
    }

    match /testExecutions/{executionId} {
      allow read, write: if isAuthenticated();
    }

    match /defects/{defectId} {
      allow read, write: if isAuthenticated();
    }

    match /reports/{reportId} {
      allow read, write: if isAuthenticated();
    }
  }
}
